use sqlite
use sql

test "Through the sql package" {
    let db = sqlite.database(memory() ! { assert(false) return })
    defer db.close()
    assert(db.dialect == sql.Dialect.sqlite)
    assert(db.ping())

    db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER, active INTEGER, avatar BLOB)") ! {
        println(E.message)
        assert(false)
        return
    }

    // Values are bound through the `?` placeholders
    let changed = db.exec("INSERT INTO users (name, age, active) VALUES (?, ?, ?)", .{
        sql.Value.of("Ada")
        sql.Value.of_int(36)
        sql.Value.of_bool(true)
    }) ! { println(E.message) assert(false) return }
    assert(changed == 1)
    assert(db.last_insert_id() == 1)

    db.exec("INSERT INTO users (name, age, active) VALUES (?, ?, ?)", .{
        sql.Value.of("Bob")
        sql.Value.of_int(20)
        sql.Value.of_bool(false)
    }) ! { assert(false) return }

    // Reading
    let rows = db.all("SELECT * FROM users ORDER BY id") ! { println(E.message) assert(false) return }
    assert(rows.length == 2)
    let first = rows.get(0) ! { assert(false) return }
    assert((first.get("name") !? sql.Value.null()).to_string() == "Ada")
    assert((first.get("age") !? sql.Value.null()).to_int() == 36)
    assert((first.get("active") !? sql.Value.null()).to_bool())
    assert((first.get("avatar") !? sql.Value.of("x")).is_null())

    // One row, one value
    let one = db.one("SELECT * FROM users WHERE name = ?", .{ sql.Value.of("Bob") }) ! { assert(false) return }
    assert(isset(one))
    if isset(one) : assert((one.get("age") !? sql.Value.null()).to_int() == 20)
    assert(!isset(db.one("SELECT * FROM users WHERE name = ?", .{ sql.Value.of("nobody") }) ! { assert(false) return }))
    assert((db.value("SELECT count(*) FROM users") ! { assert(false) return }).to_int() == 2)

    // Blobs keep every byte
    db.exec("UPDATE users SET avatar = ? WHERE id = ?", .{ sql.Value.of_blob("\x00\xff\x00"), sql.Value.of_int(1) }) ! { assert(false) return }
    let avatar = db.value("SELECT avatar FROM users WHERE id = 1") ! { assert(false) return }
    assert(avatar.is_blob())
    assert(avatar.to_string().length == 3)

    // Errors arrive as sql errors
    db.exec("INSERT INTO users (id, name) VALUES (1, 'clash')") ! {
        assert(error_is(E.code, constraint))
        assert(E.driver_code.length > 0)
    }
    db.exec("SELEC 1") ! {
        assert(error_is(E.code, syntax))
        assert(E.sql == "SELEC 1")
    }
    // And the connection keeps working
    assert((db.value("SELECT count(*) FROM users") ! { assert(false) return }).to_int() == 2)
}

test "The builder against a real database" {
    let db = sqlite.database(memory() ! { assert(false) return })
    defer db.close()
    db.exec("CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT, views INTEGER, published INTEGER)") ! { assert(false) return }

    db.insert_into("posts").values(.{ "title" => sql.Value.of("first"), "views" => sql.Value.of_int(10), "published" => sql.Value.of_bool(true) }).run() ! {
        println(E.message)
        assert(false)
        return
    }
    db.insert_into("posts").values(.{ "title" => sql.Value.of("second"), "views" => sql.Value.of_int(3), "published" => sql.Value.of_bool(false) }).run() ! { assert(false) return }
    db.insert_into("posts").values(.{ "title" => sql.Value.of("third"), "views" => sql.Value.of_int(30), "published" => sql.Value.of_bool(true) }).run() ! { assert(false) return }

    let query = db.select("title, views")
    query.from("posts")
    query.where("published = ?", .{ sql.Value.of_bool(true) })
    query.where("views > ?", .{ sql.Value.of_int(5) })
    query.order_by("views DESC")
    let rows = query.all() ! { println(E.message) assert(false) return }
    assert(rows.length == 2)
    assert(((rows.get(0) !? .{}).get("title") !? sql.Value.null()).to_string() == "third")

    // IN lists
    let in_rows = db.select().from("posts").where_in("title", .{ sql.Value.of("first"), sql.Value.of("second") }).all() ! { assert(false) return }
    assert(in_rows.length == 2)

    // Updates and deletes report what they changed
    let updated = db.update("posts").set_expression("views", "views + ?", .{ sql.Value.of_int(1) }).where("published = ?", .{ sql.Value.of_bool(true) }).run() ! { assert(false) return }
    assert(updated == 2)
    assert((db.select("views").from("posts").where("title = ?", .{ sql.Value.of("first") }).value() ! { assert(false) return }).to_int() == 11)
    let deleted = db.delete_from("posts").where("views < ?", .{ sql.Value.of_int(5) }).run() ! { assert(false) return }
    assert(deleted == 1)
    assert((db.value("SELECT count(*) FROM posts") ! { assert(false) return }).to_int() == 2)

    // RETURNING, which SQLite has
    let returned = db.insert_into("posts").values(.{ "title" => sql.Value.of("fourth"), "views" => sql.Value.of_int(0), "published" => sql.Value.of_bool(false) }).returning("id").all() ! {
        println(E.message)
        assert(false)
        return
    }
    assert(returned.length == 1)
    assert(((returned.get(0) !? .{}).get("id") !? sql.Value.null()).to_int() > 0)
}

class SqlPost {
    id: uint
    title: String
    views: int
    published: bool (false)
}

test "Rows into classes, from a real database" {
    let db = sqlite.database(memory() ! { assert(false) return })
    defer db.close()
    db.exec("CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT, views INTEGER, published INTEGER)") ! { assert(false) return }
    db.exec("INSERT INTO posts (title, views, published) VALUES (?, ?, ?)", .{ sql.Value.of("first"), sql.Value.of_int(10), sql.Value.of_bool(true) }) ! { assert(false) return }

    let rows = db.all("SELECT * FROM posts") ! { assert(false) return }
    // SQLite stores a bool as 1 or 0, so the column is named to read it back as a bool
    let posts = sql.rows_to[SqlPost](rows, .{ "published" }) ! { println(E.message) assert(false) return }
    assert(posts.length == 1)
    let post = posts.get(0) ! { assert(false) return }
    assert(post.id == 1)
    assert(post.title == "first")
    assert(post.views == 10)
    assert(post.published)
}

test "Transactions through the sql package" {
    let db = sqlite.database(memory() ! { assert(false) return })
    defer db.close()
    db.exec("CREATE TABLE t (n INTEGER)") ! { assert(false) return }

    db.transaction(fn(tx: sql.Db) !sql.Error {
        tx.exec("INSERT INTO t VALUES (1)") !>
        tx.exec("INSERT INTO t VALUES (2)") !>
    }) ! { println(E.message) assert(false) return }
    assert((db.value("SELECT count(*) FROM t") ! { assert(false) return }).to_int() == 2)

    // A transaction that throws leaves nothing behind
    db.transaction(fn(tx: sql.Db) !sql.Error {
        tx.exec("INSERT INTO t VALUES (3)") !>
        tx.exec("INSERT INTO nothing_here VALUES (4)") !>
    }) ! {
        assert(error_is(E.code, syntax))
        assert((db.value("SELECT count(*) FROM t") ! { assert(false) return }).to_int() == 2)
        return
    }
    assert(false)
}

test "Migrations on a real database" {
    let path = temp_path("sql-migrate")
    let db = sqlite.database(sqlite.open(path) ! { assert(false) return })

    let migrator = sql.Migrator.new(db)
    migrator.add_many(.{
        "0001-users.sql" => "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL);\nCREATE INDEX users_name ON users (name);"
        "0002-posts.sql" => "CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id), title TEXT);"
    })

    assert((migrator.pending() ! { assert(false) return }).length == 2)
    let ran = migrator.migrate() ! { println(E.message) assert(false) return }
    assert(ran.length == 2)
    assert((migrator.pending() ! { assert(false) return }).length == 0)
    assert((migrator.applied() ! { assert(false) return }).length == 2)

    // The tables are really there
    db.exec("INSERT INTO users (name) VALUES (?)", .{ sql.Value.of("Ada") }) ! { println(E.message) assert(false) return }
    db.exec("INSERT INTO posts (user_id, title) VALUES (?, ?)", .{ sql.Value.of_int(1), sql.Value.of("hello") }) ! { assert(false) return }
    assert((db.value("SELECT count(*) FROM posts") ! { assert(false) return }).to_int() == 1)

    // Running again does nothing, even in a new process with a new migrator
    let second = sql.Migrator.new(db)
    second.add("0001-users.sql", "CREATE TABLE users (id INTEGER PRIMARY KEY)")
    assert((second.migrate() ! { assert(false) return }).length == 0)

    // A migration that fails leaves the database as it was
    let third = sql.Migrator.new(db)
    third.add("0003-broken.sql", "CREATE TABLE ok_one (a TEXT); CREATE TABLE ok_one (a TEXT);")
    third.migrate() ! {
        assert(E.message.contains("0003-broken.sql"))
        assert((db.value("SELECT count(*) FROM sqlite_master WHERE name = 'ok_one'") ! { assert(false) return }).to_int() == 0)
        db.close()
        remove_database(path)
        return
    }
    assert(false)
}

test "A pool of real connections" {
    let path = temp_path("sql-pool")
    let setup = sqlite.open(path) ! { assert(false) return }
    setup.exec("CREATE TABLE t (n INTEGER)") ! { assert(false) return }
    setup.close()

    let pool = sql.Pool.new(fn() sql.Db !sql.Error {
        let con = sqlite.open(path) ! throw .connect { message: E.message }
        return sqlite.database(con)
    }, 3, 2)

    let db = pool.get() ! { println(E.message) assert(false) return }
    db.exec("INSERT INTO t VALUES (1)") ! { assert(false) return }
    pool.put(db)

    // The same connection comes back and sees its own write
    let again = pool.get() ! { assert(false) return }
    assert((again.value("SELECT count(*) FROM t") ! { assert(false) return }).to_int() == 1)
    pool.put(again)
    assert(pool.size == 1)

    pool.close_idle()
    assert(pool.size == 0)
    remove_database(path)
}

// The names a query answered with, sorted, so a test can read as one line
fn names_of(found: Array[Map[sql.Value]]) String {
    let names: Array[String] = .{}
    each found as row : names.append((row.get("name") !? sql.Value.null()).to_string())
    names.sort()
    return names.join(",")
}

test "Complex conditions against a real database" {
    let db = sqlite.database(memory() ! { assert(false) return })
    defer db.close()
    db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, role TEXT, score INTEGER, active INTEGER)") ! {
        println(E.message)
        assert(false)
        return
    }

    // name, role, score, active
    let rows = Array[Array[sql.Value]]{
        .{ sql.Value.of("ada"),   sql.Value.of("admin"),  sql.Value.of_int(10),  sql.Value.of_bool(true) }
        .{ sql.Value.of("bob"),   sql.Value.of("member"), sql.Value.of_int(150), sql.Value.of_bool(true) }
        .{ sql.Value.of("cid"),   sql.Value.of("member"), sql.Value.of_int(20),  sql.Value.of_bool(true) }
        .{ sql.Value.of("dora"),  sql.Value.of("admin"),  sql.Value.of_int(30),  sql.Value.of_bool(false) }
        .{ sql.Value.of("eve"),   sql.Value.of("owner"),  sql.Value.null(),      sql.Value.of_bool(true) }
        .{ sql.Value.of("frank"), sql.Value.of("owner"),  sql.Value.of_int(5),   sql.Value.of_bool(true) }
    }
    each rows as row {
        db.exec("INSERT INTO users (name, role, score, active) VALUES (?, ?, ?, ?)", row) ! { assert(false) return }
    }

    // Active users who are either an admin or scored above 100.
    // Without the group this would also return the inactive admin.
    let found = db.select("name")
        .from("users")
        .where("active = ?", .{ sql.Value.of_bool(true) })
        .where_group(fn(w: sql.Conditions) {
            w.where("role = ?", .{ sql.Value.of("admin") })
            w.or_where("score > ?", .{ sql.Value.of_int(100) })
        })
        .all() ! { println(E.message) assert(false) return }
    assert(names_of(found) == "ada,bob")

    // The same conditions without the group: AND binds tighter, so dora comes along
    let ungrouped = db.select("name")
        .from("users")
        .where("active = ? AND role = ? OR score > ?", .{ sql.Value.of_bool(true), sql.Value.of("admin"), sql.Value.of_int(100) })
        .all() ! { assert(false) return }
    assert(names_of(ungrouped) == "ada,bob")

    // An OR of two ANDs, with a nested OR inside the second one:
    // (admin AND active) OR (owner AND (score > 4 OR score IS NULL))
    let either = db.select("name")
        .from("users")
        .where_group(fn(w: sql.Conditions) {
            w.where("role = ?", .{ sql.Value.of("admin") })
            w.where("active = ?", .{ sql.Value.of_bool(true) })
        })
        .or_where_group(fn(w: sql.Conditions) {
            w.where("role = ?", .{ sql.Value.of("owner") })
            w.group(fn(inner: sql.Conditions) {
                inner.where("score > ?", .{ sql.Value.of_int(4) })
                inner.or_where_null("score")
            })
        })
        .order_by("name")
        .all() ! { println(E.message) assert(false) return }
    assert(names_of(either) == "ada,eve,frank")

    // IN and NOT IN together with an OR
    let lists = db.select("name")
        .from("users")
        .where_in("role", .{ sql.Value.of("admin"), sql.Value.of("owner") })
        .where_not_in("name", .{ sql.Value.of("dora") })
        .or_where("score > ?", .{ sql.Value.of_int(100) })
        .all() ! { assert(false) return }
    assert(names_of(lists) == "ada,bob,eve,frank")

    // A count with a mixed condition, to check the values line up with their placeholders
    let count = db.select("count(*) AS n")
        .from("users")
        .where_group(fn(w: sql.Conditions) {
            w.where("score >= ?", .{ sql.Value.of_int(10) })
            w.or_where_null("score")
        })
        .where("active = ?", .{ sql.Value.of_bool(true) })
        .value() ! { println(E.message) assert(false) return }
    assert(count.to_int() == 4) // ada, bob, cid, eve

    // HAVING mixes as well
    let grouped = db.select("role, count(*) AS n")
        .from("users")
        .group_by("role")
        .having("count(*) > ?", .{ sql.Value.of_int(2) })
        .or_having("role = ?", .{ sql.Value.of("admin") })
        .order_by("role")
        .all() ! { println(E.message) assert(false) return }
    assert(grouped.length == 1)
    assert(((grouped.get(0) !? .{}).get("role") !? sql.Value.null()).to_string() == "admin")

    // An UPDATE with an OR touches exactly the rows it should
    let changed = db.update("users")
        .set("active", sql.Value.of_bool(false))
        .where("role = ?", .{ sql.Value.of("owner") })
        .or_where("score < ?", .{ sql.Value.of_int(15) })
        .run() ! { println(E.message) assert(false) return }
    assert(changed == 3) // ada (10), eve and frank (owners)
    assert((db.value("SELECT count(*) FROM users WHERE active = 1") ! { assert(false) return }).to_int() == 2)
}

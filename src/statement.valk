value STATE_IDLE (0)
value STATE_ROW (1)
value STATE_DONE (2)

/// A statement prepared once and run as often as needed, made by `Connection.prepare`.
///
/// Its values go in by name, as with `Connection.query`, and its rows are read with the fetch
/// methods of the connection. `close` releases it; a statement that is dropped without that is
/// released when it is collected.
///
/// ```valk
/// let insert = db.prepare("INSERT INTO users (name, age) VALUES (:name, :age)") ! panic("%{E.message}")
/// defer insert.close()
/// each people as person {
///     insert.run(.{ "name" => person.name, "age" => person.age }) ! panic("%{E.message}")
/// }
/// ```
+ class Statement {
    stmt: STMT
    /// The SQL the statement was prepared from.
    ~+ sql: String
    // Keeps the connection alive for as long as the statement is in use
    con: Connection
    column_count: uint (0)
    finalized: bool (false)
    // Per placeholder, the name its value is taken from; set for a statement from `prepare`
    names: ?Array[String] (null)
    // Read on the first run
    column_names: ?Array[String] (null)

    // A prepared statement is a handle into SQLite, not a value: a copy would finalize the same
    // statement twice, so a clone is the same statement
    fn clone() SELF $clone {
        return this
    }

    /// Runs the statement with `values` bound to its `:name` placeholders. Rows, if any, are
    /// read with `fetch_row`, `fetch_one`, `fetch_all` or `fetch_value` of the connection.
    ///
    /// Every placeholder needs a value; a name without one throws `syntax`.
    + fn query(values: ?Map[?Value] (null)) !Error {
        this.con.query_prepared(this, values) !>
    }

    /// Runs the statement and returns how many rows it changed.
    + fn run(values: ?Map[?Value] (null)) uint !Error {
        let con = this.con
        con.query_prepared(this, values) !>
        con.stop()
        return con.affected_rows
    }

    /// Runs the statement and returns every row it answered with.
    + fn select(values: ?Map[?Value] (null)) Array[Map[Value]] !Error {
        let con = this.con
        con.query_prepared(this, values) !>
        return con.fetch_all() !>
    }

    /// Runs the statement and returns the first column of its first row, NULL when there is
    /// none.
    + fn value(values: ?Map[?Value] (null)) Value !Error {
        let con = this.con
        con.query_prepared(this, values) !>
        let value = con.fetch_value() !>
        con.stop()
        return value
    }

    /// Releases the statement. Running it afterwards throws `closed`.
    + fn close() {
        let current = this.con.current
        if isset(current) && current == this : this.con.stop()
        this.finalize()
    }

    // Puts the statement back in the state it was prepared in
    fn reset() {
        @unsafe
        if this.finalized : return
        sqlite3_reset(this.stmt)
        sqlite3_clear_bindings(this.stmt)
    }

    fn finalize() {
        @unsafe
        if this.finalized : return
        this.finalized = true
        sqlite3_finalize(this.stmt)
    }

    // SQLite frees a statement of a closed connection by itself, so this only has to run for a
    // statement that is dropped while its connection lives on
    fn gc_free() {
        @unsafe
        if this.finalized : return
        sqlite3_finalize(this.stmt)
    }
}

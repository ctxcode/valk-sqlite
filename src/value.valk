use valk.json

/// The kinds of `Value`, which are the storage classes of SQLite.
+ enum TYPE {
    null
    int
    float
    /// Text. A `String` holds bytes, so text and blobs are both read without copying twice.
    string
    blob
}

/// A value read from a row, or bound to a query.
///
/// SQLite stores what it is given rather than what a column declares, so a column declared
/// `INTEGER` can hold text. `type` says what came back and the `to_*` methods convert.
+ class Value {
    /// Which of the kinds this value is.
    + type: TYPE
    int_value: int (0)
    float_value: float (0)
    string_value: String ("")

    /// Returns a NULL value.
    + static fn null() Value {
        return Value { type: TYPE.null }
    }
    /// Returns a text value.
    + static fn of(text: String) Value {
        return Value { type: TYPE.string, string_value: text }
    }
    /// Returns an integer value.
    + static fn of_int(number: int) Value {
        return Value { type: TYPE.int, int_value: number }
    }
    /// Returns a floating point value.
    + static fn of_float(number: float) Value {
        return Value { type: TYPE.float, float_value: number }
    }
    /// Returns a blob value; the bytes are stored as they are.
    + static fn of_blob(data: String) Value {
        return Value { type: TYPE.blob, string_value: data }
    }

    /// Returns whether the value is NULL.
    + fn is_null() bool {
        return this.type == TYPE.null
    }
    /// Returns whether the value is a blob.
    + fn is_blob() bool {
        return this.type == TYPE.blob
    }

    /// Returns the value as text; numbers are formatted, NULL becomes "".
    + fn to_string() String $auto {
        let type = this.type
        if type == TYPE.string || type == TYPE.blob : return this.string_value
        if type == TYPE.int : return this.int_value.to(String)
        if type == TYPE.float : return this.float_value.to_shortest_string()
        return ""
    }
    /// Like `to_string`, but null for NULL, which tells an empty value apart from a missing one.
    + fn to_string_or_null() ?String {
        if this.type == TYPE.null : return null
        return this.to_string()
    }
    /// Returns the value as an integer; text is parsed, floats are truncated, NULL is 0.
    + fn to_int() int {
        let type = this.type
        if type == TYPE.int : return this.int_value
        if type == TYPE.float : return this.float_value.to(int)
        if type == TYPE.string || type == TYPE.blob {
            return this.string_value.to_int() !? (this.string_value.to_float() !? 0).to(int)
        }
        return 0
    }
    /// Returns the value as an unsigned integer; negative numbers become 0.
    + fn to_uint() uint {
        let value = this.to_int()
        if value < 0 : return 0
        return value.to(uint)
    }
    /// Returns the value as a float; text is parsed, NULL is 0.
    + fn to_float() float {
        let type = this.type
        if type == TYPE.float : return this.float_value
        if type == TYPE.int : return this.int_value
        if type == TYPE.string || type == TYPE.blob : return this.string_value.to_float() !? 0
        return 0
    }
    /// Returns the value as a bool: any number other than 0, and the texts `1`, `true`, `t`,
    /// `yes` and `on`, are true.
    ///
    /// SQLite has no boolean type of its own; `true` and `false` in SQL are the numbers 1 and 0.
    + fn to_bool() bool {
        let type = this.type
        if type == TYPE.int : return this.int_value != 0
        if type == TYPE.float : return this.float_value != 0
        if type == TYPE.string {
            let text = this.string_value
            return text == "1" || text == "true" || text == "t" || text == "yes" || text == "on"
        }
        return false
    }
    /// Parses the value as JSON. Returns json null when the text is not valid JSON.
    + fn to_json() json.Value {
        let type = this.type
        if type == TYPE.int : return json.new_int(this.int_value)
        if type == TYPE.float : return json.new_float(this.float_value)
        if type == TYPE.null : return json.new_null()
        return json.decode(this.to_string()) !? json.new_null()
    }
}

extend bool {
    + fn to_sqlite_value() Value $auto {
        return Value { type: TYPE.int, int_value: this ? 1 : 0 }
    }
}
extend int {
    + fn to_sqlite_value() Value $auto {
        return Value { type: TYPE.int, int_value: this }
    }
}
extend uint {
    + fn to_sqlite_value() Value $auto {
        return Value { type: TYPE.int, int_value: this.to(int) }
    }
}
extend float {
    + fn to_sqlite_value() Value $auto {
        return Value { type: TYPE.float, float_value: this }
    }
}
extend String {
    + fn to_sqlite_value() Value $auto {
        return Value { type: TYPE.string, string_value: this }
    }
}
extend json.Value {
    + fn to_sqlite_value() Value $auto {
        return Value { type: TYPE.string, string_value: this.encode() }
    }
}

/// Converts any supported value (integers, floats, bools, text, json values, and nullable
/// versions of those) into a `Value`.
+ fn convert(ndata: $T) Value {
    #if T.$is_nullable
    if !isset(ndata) : return Value { type: TYPE.null }
    #end

    let data = ndata

    #if T.$is_type_of(Value)
    return data
    #elif T.$can_convert_to(Value)
    return data.to(Value)
    #elif T.$has_method(to_sqlite_value)
    return data.to_sqlite_value()
    #elif T.$is_bool
    return Value { type: TYPE.int, int_value: data ? 1 : 0 }
    #elif T.$is_integer
    return Value { type: TYPE.int, int_value: data.to(int) }
    #elif T.$is_float
    return Value { type: TYPE.float, float_value: data.to(float) }
    #else
    #error "Cannot convert this value to a sqlite Value"
    #end
}
